# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，严禁提交真实凭据

# HTTP 监听端口
PORT=8090

# MySQL 连接串（默认对应仓库根目录 docker-compose.yml 的 3307 映射）
DB_DSN=root:modernchat_sso_dev@tcp(127.0.0.1:3307)/modernchat_sso?charset=utf8mb4&parseTime=true&loc=Local

# JWT 签名密钥（必填，≥32 字节；生成：openssl rand -hex 32）
# 与主仓库 modern-chat-new 共享同一值即可互认 token——前提是 uid 空间一致（见 AGENTS.md）
JWT_SECRET=

# mc_auth cookie 是否带 Secure；生产必须 true
COOKIE_SECURE=false

# ── 邮件发送（邮箱验证用）──
# 通道列表，逗号分隔、按序故障转移（主选失败自动降级下一通道），如 tencent_ses,smtp
# 可选值：console（仅本地开发，内容只打日志不发真信）| smtp | tencent_ses（其他厂商按同接口扩展）
MAIL_PROVIDER=console
# SMTP 参数（MAIL_PROVIDER=smtp 时必填）：465 走隐式 TLS；587/25 走 STARTTLS（明文连接上不发送凭据）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 腾讯云 SES（MAIL_PROVIDER=tencent_ses 时必填）：凭据严禁入库
# 需在 SES 控制台：① 验证发件地址 ② 建一个正文为 {{content}} 的模板并审核通过
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM=
TENCENT_SES_TEMPLATE_ID=
